# Base URL of the existing Express API. No trailing slash.
# Copy this file to .env for Expo Go on a phone. Use this computer's LAN address, not localhost.
# Example: http://192.168.1.20:5000
#
# Production and preview builds do not read this file. Set EXPO_PUBLIC_API_URL
# in the matching EAS environment instead. Use https:// for any network that is
# not a trusted lab. Never put the database URI, JWT secret, or detection token here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
